---
import { Image } from 'astro:assets';
import twoWomenSittingImage from '/src/assets/images/two-women-sitting.png';

const aboutContent = [
  {
    id: 1,
    title: 'Сначала смотрим, что можно сохранить',
    text: 'Не считаю, что хороший интерьер начинается с полной замены мебели. Иногда достаточно нескольких точных изменений, чтобы пространство стало выглядеть совсем иначе.',
  },
  {
    id: 2,
    title: 'Красиво ≠ дорого',
    text: 'Мне нравится находить эффектные вещи по разумной цене и сочетать предметы из разных магазинов так, чтобы интерьер выглядел цельным.',
  },
  {
    id: 3,
    title: 'Для жизни, а не только для фотографии',
    text: 'Продумываю не только внешний вид, но и бытовые мелочи: хранение, освещение, технику и всё, чем человек будет пользоваться каждый день.',
  },
];
---

<section id="about" class="about">
  <div class="section-container">
    <span class="section-tag">МОЙ ПОДХОД</span>
    <h2 class="section-title">Красиво не обязательно значит дорого</h2>

    <div class="about-container">
      <div class="about-image-wrapper">
        <Image
          src={twoWomenSittingImage}
          alt="Интерьер с мебелью, текстилем, освещением и декоративными деталями."
          class="media"
        />
      </div>

      <div class="about-content">
        {
          aboutContent.map(content => (
            <>
              <h3 class="section-subtitle about-subtitle">{content.title}</h3>
              <p class="about-text">{content.text}</p>
            </>
          ))
        }

        <p class="about-text">
          Я не занимаюсь капитальным ремонтом, перепланировкой и инженерными
          решениями. Моя задача начинается там, где ремонт уже закончен и
          пространство нужно наполнить жизнью.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: center;
  }

  .about-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 28.125rem;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .about-content {
    max-width: 37.5rem;
  }

  .about-text {
    margin-bottom: var(--px-32);
  }

  .about-text:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 25rem;
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 21.875rem;
      order: -1;
    }
  }
</style>