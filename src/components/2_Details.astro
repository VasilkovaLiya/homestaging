---
import BaseSwiper from "./BaseSwiper.astro";
import { Image } from "astro:assets";

import vanityImage from "/src/assets/images/туалетный столик.png";
import storageImage from "/src/assets/images/студия 354_1.png";
import corkBoardImage from "/src/assets/images/студия 354_1.png";
import bathroomImage from "/src/assets/images/студия 354_1.png";


const details = [
    {
        id: 1,
        image: {
            src: vanityImage,
            alt: "Туалетный столик с ярким креслом в оформленном интерьере.",
        },
        info: {
            title: "Не боюсь цвета",
            text: "Яркий акцент может собрать весь интерьер. А мебель нужного размера можно сделать на заказ — так пространство используется по максимуму, а всё необходимое помещается внутри.",
        },
    },

    {
        id: 2,
        image: {
            src: bathroomImage,
            alt: "Продуманная система хранения в ванной комнате.",
        },
        info: {
            title: "Хранение под привычки хозяев",
            text: "Продумываю не просто место для хранения, а то, чем действительно будут пользоваться: высокие флаконы, небольшие баночки, полотенца и бытовые мелочи.",
        },
    },

    {
        id: 3,
        image: {
            src: corkBoardImage,
            alt: "Пробковая доска как функциональный элемент оформления стены.",
        },
        info: {
            title: "Стены тоже могут быть живыми",
            text: "Необязательно заполнять их только картинами и постерами. Иногда функциональная вещь может стать частью интерьера — и меняться вместе с вами.",
        },
    },

    {
        id: 4,
        image: {
            src: storageImage,
            alt: "Сочетание графитового шкафа и белого стеллажа в интерьере.",
        },
        info: {
            title: "Сочетаю, а не комплектую",
            text: "Мебель из разных коллекций может выглядеть цельно. Главное — найти связь в цвете, пропорциях и деталях и не потерять функциональность.",
        },
    },
];
---

<section class="details" id="details" >
    <div class="section-container">
        <span class="section-tag">Цвет</span>
        <h2 class="section-title">Детали решают</h2>        
        <p class="middle-text">Цвет, хранение, мебель нужного размера и оформление стен — иногда именно детали делают пространство удобным и цельным.</p>
        <BaseSwiper sliderName="details">
            {
                details.map((detail) => (
                    <div class="swiper-slide">
                         <div class="detail-info">
                            <h3 class="section-subtitle detail-title">
                                {detail.info.title}
                            </h3>
        
                            <p class="detail-text">
                                {detail.info.text}
                            </p>
                        </div>
                        <div class="detail-image">
                            <Image
                                class="image"
                                src={detail.image.src}
                                alt={detail.image.alt}
                                width={1144}
                                height={1200}
                            />
                        </div>
        
                       
                    </div>
                ))
            }
        </BaseSwiper>
    </div>
</section>

<style>    
.details {
    background-color: var(--color-background);
}
    :global(.details-swiper) {
        padding-inline: var(--px-64);
        position: relative;
    }

    .swiper-slide {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        opacity: 0;
        transform: scale(0.75);
        transition: all var(--transition-long);
    }

    .swiper-slide-active {
        opacity: 1;
        transform: scale(1);
    }

    .swiper-slide-prev,
    .swiper-slide-next {
        opacity: 0;
        transform: scale(0.75);
    }

    .project-image {
    position: relative;
    min-height: 25rem;
    overflow: hidden;
}

.detail-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
}

   

    .detail-image .image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

   
    .detail-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--px-32);
    }

    .info-section {
        display: flex;
        flex-direction: column;
        gap: var(--px-16);
    }

    .info-title {
        margin-bottom: 0;
    }

    .view-details {
        display: inline-flex;
        font-weight: 500;
        margin-top: auto;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    .btn--secondary-hovered {
        display: block;
    }

    @media screen and (max-width: 64rem) {
        .swiper-slide {
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 55rem) {
        :global(.portfolio-swiper),
        :global(.details-swiper) {
            padding-inline: 0;
        }

        .swiper-slide {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }
    }
    .middle-text {
        margin-block: var(--px-64) var(--px-64);
    }
</style>

<script>
    import { initSwiper } from "@utils/initSwiper";

    function initDetailsSlider() {
        console.log('init det')
        const detailsSwiper = initSwiper("details", {
            spaceBetween: 30,

            navigation: {
                nextEl: ".details-next",
                prevEl: ".details-prev",
            },

            pagination: {
                el: ".details-pagination",
                clickable: true,
            },
        });

        return () => {
            detailsSwiper?.destroy();
        };
    }

    let cleanup = initDetailsSlider();

    document.addEventListener("astro:after-swap", () => {
        if (cleanup) cleanup();
        cleanup = initDetailsSlider();
    });
</script>