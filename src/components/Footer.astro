---
import { SITE } from "@consts";

const currentYear = new Date().getFullYear();
---

<footer class="main-footer">
    <div class="section-container footer-inner">
        <div class="footer-main">
            <div class="footer-intro">
                <p class="footer-title">
                    Хоумстейджинг и подготовка квартир к аренде и продаже
                </p>

                <div class="footer-contacts">
                    <a href={`tel:${SITE.TELEPHONE}`} class="footer-link">
                        {SITE.TELEPHONE}
                    </a>

                    <a href={`mailto:${SITE.EMAIL}`} class="footer-link">
                        {SITE.EMAIL}
                    </a>

                    <span class="footer-location">
                        Челябинск
                    </span>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="copyright">
                © {currentYear} Имя Фамилия
            </p>

            <a href="/legal/privacy" class="footer-link footer-policy">
                Политика конфиденциальности
            </a>
        </div>
    </div>
</footer>

<style>
    .main-footer {
        background-color: var(--color-background);
        color: var(--color-text-dark);
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        padding: var(--px-32) var(--px-64);
    }

    .footer-inner {
        display: flex;
        flex-direction: column;
    }

    .footer-main {
        display: flex;
        justify-content: space-between;
        padding-bottom: var(--px-48);
    }

    .footer-intro {
        max-width: 38rem;
    }

    .footer-title {
        margin: 0 0 var(--px-24);
        font-size: var(--text-2xl);
        font-weight: 600;
        line-height: 1.35;
        color: var(--color-text-primary);
    }

    .footer-contacts {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--px-12) var(--px-24);
        font-size: var(--text-sm);
    }

    .footer-link {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-short);
    }

    .footer-location {
        opacity: 0.7;
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--px-24);
        padding-top: var(--px-24);
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        font-size: var(--text-sm);
    }

    .copyright {
        margin: 0;
        opacity: 0.7;
    }

    .footer-policy {
        opacity: 0.7;
    }

    @media (hover: hover) and (pointer: fine) {
        .footer-link:hover {
            color: var(--color-text-primary);
        }
    }

    @media screen and (max-width: 48rem) {
        .main-footer {
            padding-block: var(--px-48) var(--px-24);
        }

        .footer-main {
            padding-bottom: var(--px-32);
        }

        .footer-title {
            font-size: var(--text-lg);
            margin-bottom: var(--px-20);
        }

        .footer-contacts {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--px-8);
        }

        .footer-bottom {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--px-8);
            padding-top: var(--px-20);
        }
    }
</style>