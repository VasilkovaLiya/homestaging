---
import { Image } from "astro:assets";
import consultationImage from "/src/assets/images/consultation.jpg";
import step2 from "/src/assets/images/step2.png";
import transformImage from "/src/assets/images/transform.jpg";

const processSteps = [
    {
        id: 1,
        title: "01. Знакомимся",
        description:
            "Бесплатно созвонимся на 30–40 минут. Вы покажете квартиру и расскажете о задаче, пожеланиях и бюджете.",
        image: {
            src: consultationImage,
            alt: "Обсуждение задачи и пожеланий по обустройству квартиры",
        },
    },
    {
        id: 2,
        title: "02. Собираем решение",
        description:
            "Определяем, что можно сохранить, что стоит заменить и чего не хватает. Я подбираю конкретные предметы и согласовываю их с вами.",
        image: {
            src: step2,
            alt: "Подбор мебели, текстиля, освещения и декора для интерьера",
        },
    },
    {
        id: 3,
        title: "03. Реализуем",
        description:
            "Заказываем выбранное. При необходимости я координирую доставки, сборку и установку, а в финале помогаю подготовить интерьер к съёмке.",
        image: {
            src: transformImage,
            alt: "Обустройство и финальная подготовка готового интерьера",
        },
    },
];
---

<section id="how-it-works" class="process">
    <div class="section-container">
        <div class="process-content">
            <span class="section-tag">КАК Я РАБОТАЮ</span>
            <h2 class="section-title">
                От первой встречи до готовой квартиры
            </h2>
            <div class="process-steps">
                {
                    processSteps.map((step) => (
                        <div class="process-step">
                            <div class="process-step-content">
                                <h3 class="section-subtitle process-step-title">
                                    {step.title}
                                </h3>
                                <p class="process-step-description">
                                    {step.description}
                                </p>
                            </div>
                            <div class="process-step-image-wrapper">
                                <Image
                                    src={step.image.src}
                                    alt={step.image.alt}
                                    width={1272}
                                    height={660}
                                    class="media"
                                />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .process-steps {
        display: flex;
        flex-direction: column;
        gap: var(--px-64);
    }

    .process-step {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: center;
    }

    .process-step:nth-child(even) {
        direction: rtl;
    }

    .process-step:nth-child(even) .process-step-content {
        direction: ltr;
    }

    .process-step-title {
        font-size: 1.313rem;
    }

    .process-step-description {
        max-width: 31.25rem;
    }

    .process-step-image-wrapper {
        width: 100%;
        height: 100%;
        max-height: 20.625rem;
        overflow: hidden;
    }

    @media screen and (max-width: 64rem) {
        .process-step {
            gap: var(--px-32);
        }

        .process-images {
            max-height: 18rem;
        }
    }

    @media screen and (max-width: 48rem) {
        .process-steps {
            gap: var(--px-36);
        }

        .process-step {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .process-step:nth-child(even) {
            direction: ltr;
        }

        .process-step-content {
            order: -1;
        }

        .process-step-description {
            max-width: 100%;
        }

        .process-images {
            max-height: 15rem;
        }
    }
</style>