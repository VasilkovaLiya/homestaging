---
import VaseIcon1 from "/src/components/icons/Vase1.astro";
import VaseIcon2 from "/src/components/icons/Vase2.astro";
import VaseIcon3 from "/src/components/icons/Cactus.astro";

const services = [
    {
        id: 1,
        icon: VaseIcon1,
        client: {
            name: "Освежить интерьер",
            location: "Когда основное уже есть",
        },
        content:
            "Если квартира уже обставлена, но выглядит безлико или незаконченно, помогу сделать интерьер более цельным и привлекательным. Подберу свет, текстиль, декор, зеркала и отдельные предметы мебели — от списка покупок до заказа и установки.",
    },
    {
        id: 2,
        icon: VaseIcon2,
        client: {
            name: "Обустроить квартиру после ремонта",
            location: "От пустого помещения — к готовому интерьеру",
        },
        content:
            "Если ремонт уже закончен, помогу полностью обустроить квартиру с учётом пространства и бюджета. Подберу мебель, свет, текстиль, технику и декор. При необходимости возьму на себя заказы, доставку и контроль установки.",
    },
    {
        id: 3,
        icon: VaseIcon3,
        client: {
            name: "Подготовить квартиру к сдаче",
            location: "Полная комплектация для аренды",
        },
        content:
            "Подготовлю квартиру к долгосрочной или посуточной аренде — от мебели и техники до посуды, текстиля, белья и необходимых бытовых мелочей. В результате квартира будет готова к заселению и фотосъёмке.",
    },
];
---

<section id="services" class="services">
    <div class="section-container">
        <span class="section-tag">УСЛУГИ</span>

        <h2 class="section-title">
            От небольшого обновления до полностью готовой квартиры
        </h2>

        <div class="services-grid">
            {
                services.map((service) => {
                    const Icon = service.icon;
        
                    return (
                        <article class="service-card">
                            <div class="service-header">
                                <div class="service-icon" aria-hidden="true">
                                    <Icon />
                                </div>
        
                                <div class="client-info">
                                    <h3 class="client-name">
                                        {service.client.name}
                                    </h3>
        
                                    <span class="client-location">
                                        {service.client.location}
                                    </span>
                                </div>
                            </div>
        
                            <div class="service-content">
                                <p>{service.content}</p>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--px-48);
        align-items: stretch;
    }

    .service-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .service-header {
        display: flex;
        align-items: center;
        gap: var(--px-16);
        margin-block: var(--px-32) var(--px-24);
    }

    .service-icon {
    width: var(--px-80);
    height: var(--px-80);
    flex: 0 0 var(--px-80);

    color: var(--color-accent);
}

.service-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
}

    .client-info {
        display: flex;
        flex-direction: column;
        gap: var(--px-4);
    }

    .client-name {
        margin: 0;
        font-size: var(--text-xl);
        font-weight: 600;
        font-style: normal;
    }

    .client-location {
        opacity: 0.7;
    }

    .service-content {
        flex-grow: 1;
    }

    .service-content p {
        margin: 0;
    }

    @media screen and (max-width: 64rem) {
        .services-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 48rem) {
        .services-grid {
            grid-template-columns: 1fr;
            gap: var(--px-24);
        }

        .service-card {
            max-width: none;
        }

        .service-header {
            margin-block: var(--px-24) var(--px-16);
        }
    }
</style>