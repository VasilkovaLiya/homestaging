---
const faqItems = [
  {
    id: 1,
    question: 'Сколько стоят ваши услуги?',
    answer:
      'Стоимость зависит от площади квартиры, задачи и объёма работы. Можно ограничиться подбором отдельных предметов и списком покупок, а можно передать мне комплектацию и организацию полностью. После бесплатной консультации я смогу предложить подходящий формат и назвать стоимость.',
  },
  {
    id: 2,
    question: 'Что входит в бесплатную консультацию?',
    answer:
      'Это 30–40 минут знакомства и обсуждения квартиры. Вы показываете фотографии или планировку, рассказываете о задаче, пожеланиях и бюджете. В результате мы понимаем, какой объём работы нужен и чем именно я могу быть полезна.',
  },
  {
    id: 3,
    question: 'Можно заказать только подбор мебели и декора?',
    answer:
      'Да. Необязательно передавать мне весь проект. Я могу подобрать конкретные предметы, подготовить список покупок со ссылками и предложить несколько вариантов в рамках вашего бюджета.',
  },
  {
    id: 4,
    question: 'Вы сами можете заказать мебель и организовать доставку?',
    answer:
      'Да. При необходимости я могу взять на себя оформление заказов, координацию доставок, сборки и установки. Объём этой работы мы заранее согласуем.',
  },
  {
    id: 5,
    question: 'Можно ли работать с тем, что уже есть в квартире?',
    answer:
      'Конечно. Более того, я всегда сначала смотрю, что можно сохранить, переставить, обновить или по-новому обыграть. Не считаю, что хороший интерьер обязательно требует полной замены мебели.',
  },
  {
    id: 6,
    question: 'Работаете с ограниченным бюджетом?',
    answer:
      'Да. Бюджет обсуждаем в самом начале. Я подбираю решения с учётом заданной суммы и стараюсь находить эффектные вещи без лишней переплаты.',
  },
  {
    id: 7,
    question: 'Вы занимаетесь ремонтом?',
    answer:
      'Нет. Я подключаюсь, когда основные ремонтные работы уже закончены. Не занимаюсь перепланировкой, инженерными решениями и капитальным ремонтом. Моя зона — мебель, свет, текстиль, техника, декор и функциональное наполнение.',
  },
  {
    id: 8,
    question: 'Можно полностью подготовить квартиру к аренде?',
    answer:
      'Да. Для долгосрочной или посуточной аренды могу помочь не только с интерьером, но и с полным бытовым наполнением: техникой, посудой, бельём, полотенцами, хранением и другими необходимыми мелочами.',
  },
  {
    id: 9,
    question: 'Сколько времени занимает проект?',
    answer:
      'Срок зависит от объёма задачи, площади квартиры, наличия выбранных товаров и сроков доставки. После консультации и согласования объёма работ я смогу дать более точный ориентир.',
  },
  {
    id: 10,
    question: 'Можно обратиться, если квартира обустраивается для себя?',
    answer:
      'Да. Основной акцент моей работы — квартиры для аренды и продажи, но если ремонт уже закончен и нужна помощь с мебелью, светом, текстилем, техникой или финальным оформлением для собственного проживания, такую задачу тоже можно обсудить.',
  },
];
---

<section id="faq" class="faq">
  <div class="section-container faq-container">
    <div class="faq-header">
      <span class="section-tag">ВОПРОСЫ</span>
      <h2 class="section-title">Возможно, ответ уже здесь.</h2>
    </div>

    <div class="faq-content">
      <div class="accordion">
        {
          faqItems.map(item => (
            <div class="accordion-item">
              <button class="accordion-button">
                <span class="button-text">{item.question}</span>
                <svg
                  class="button-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </button>
              <div class="accordion-content">
                <div class="content-wrapper">
                  <p>{item.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .faq-header {
    position: sticky;
    top: var(--px-32);
    max-width: 80%;
  }

  .accordion {
    display: flex;
    flex-direction: column;
  }

  .accordion-item {
    border-bottom: var(--px-1) solid var(--color-primary);
  }

  .accordion-button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--px-16);
    padding: var(--px-20) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-long);
  }

  .button-text {
    font-size: var(--text-xl);
    font-weight: 400;
    transition: all var(--transition-long);
  }

  .button-icon {
    width: var(--px-20);
    height: var(--px-20);
    transition: all var(--transition-long);
    flex-shrink: 0;
  }

  .accordion-item.active .button-text {
    font-weight: 500;
  }

  .accordion-item.active .button-icon {
    transform: rotate(45deg);
  }

  .accordion-content {
    height: 0;
    overflow: hidden;
    transition: height var(--transition-long);
  }

  .content-wrapper {
    padding-bottom: 0.813rem;
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--transition-long);
  }

  .accordion-item.active .content-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .accordion-button:hover .button-text,
    .accordion-button:hover .button-icon {
      opacity: 0.65;
    }
  }

  @media (max-width: 64rem) {
    .faq-container {
      gap: var(--px-32);
    }
  }

  @media (max-width: 48rem) {
    .faq-container {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .faq-header {
      position: static;
      max-width: none;
    }

    .section-title {
      margin-bottom: var(--px-44);
    }
  }
</style>

<script>
  function initFAQAccordion() {
    const accordionContainer = document.querySelector('.faq-container');

    if (!accordionContainer) return;

    accordionContainer.addEventListener('click', e => {
      const button = (e.target as HTMLElement).closest('.accordion-button');

      if (!button) return;

      const item = button.closest('.accordion-item');
      const content = item?.querySelector<HTMLElement>('.accordion-content');

      if (!item || !content) return;

      const isActive = item.classList.contains('active');

      document.querySelectorAll('.accordion-item.active').forEach(accItem => {
        const accContent =
          accItem.querySelector<HTMLElement>('.accordion-content');
        const accButton = accItem.querySelector('.accordion-button');

        if (!accContent || !accButton) return;

        if (accItem !== item) {
          accItem.classList.remove('active');
          accContent.style.height = '0';
          accButton.setAttribute('aria-expanded', 'false');
          accContent.setAttribute('aria-hidden', 'true');
        }
      });

      if (!isActive) {
        item.classList.add('active');
        content.style.height = content.scrollHeight + 'px';
        button.setAttribute('aria-expanded', 'true');
        content.setAttribute('aria-hidden', 'false');
      } else {
        item.classList.remove('active');
        content.style.height = '0';
        button.setAttribute('aria-expanded', 'false');
        content.setAttribute('aria-hidden', 'true');
      }
    });
  }

  initFAQAccordion();
  document.addEventListener('astro:after-swap', initFAQAccordion);
</script>