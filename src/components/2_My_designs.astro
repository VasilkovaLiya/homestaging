---
import BaseSwiper from "./BaseSwiper.astro";
import { Image } from "astro:assets";

import before1Image from "/src/assets/images/студия 353 _2.png";
import after1Image from "/src/assets/images/студия 353 _1.png";

import vanityImage from "/src/assets/images/туалетный столик.png";
import hallImage from "/src/assets/images/hall.png";
import corkBoardImage from "/src/assets/images/доска.png";

import after2Image from "/src/assets/images/студия 354_1.png";

import before2Image from "/src/assets/images/студия 354_2.png";
import bathroomImage from "/src/assets/images/bathroom_detai.jpg";


const slides = [
    {
        id: 1,
        type: "transformation",
        title: "Из пустого пространства — в готовый интерьер",
        items: [
            {
                image: before1Image,
                label: "До",
                text: "Готовый ремонт без мебели, текстиля и бытового наполнения.",
                alt: "Студия до обустройства: пустое помещение после ремонта.",
            },
            {
                image: after1Image,
                label: "После",
                text: "Полностью оборудованная студия, готовая к аренде и заселению.",
                alt: "Студия после обустройства: мебель, текстиль, освещение и декор.",
            },
        ],
    },

    {
        id: 2,
        type: "gallery",
        items: [
            {
                image: hallImage,
                orientation: "landscape",
                text: "Спокойная композиция, где функциональные детали становятся частью интерьера.",
                alt: "Деталь оформленного интерьера.",
            },
            {
                image: vanityImage,
                orientation: "portrait",
                text: "Текстиль, свет и небольшие акценты делают пространство визуально завершённым.",
                alt: "Интерьерная композиция с текстилем и декором.",
            },
        ],
    },

    {
        id: 3,
        type: "transformation",
        title: "Когда интерьеру не нужен новый ремонт",
        items: [
            {
                image: before2Image,
                label: "До",
                text: "Готовое пространство с базовым наполнением и разрозненными деталями.",
                alt: "Интерьер до обновления.",
            },
            {
                image: after2Image,
                label: "После",
                text: "Более цельный интерьер за счёт света, текстиля, мебели и декора.",
                alt: "Интерьер после обновления.",
            },
        ],
    },

    {
        id: 4,
        type: "gallery",
        items: [
            {
                image: corkBoardImage,
                orientation: "portrait",
                text: "Небольшие предметы помогают собрать интерьер без ощущения перегруженности.",
                alt: "Деталь авторского оформления интерьера.",
            },
            {
                image: hallImage,
                orientation: "landscape",
                text: "Функциональное пространство может оставаться уютным и визуально лёгким.",
                alt: "Авторская интерьерная фотография.",
            },
        ],
    },
    {
        id: 5,
        type: "gallery",
        items: [
            {
                image: bathroomImage,
                orientation: "portrait",
                text: "Небольшие предметы помогают собрать интерьер без ощущения перегруженности.",
                alt: "Деталь авторского оформления интерьера.",
            },
            {
                image: hallImage,
                orientation: "landscape",
                text: "Функциональное пространство может оставаться уютным и визуально лёгким.",
                alt: "Авторская интерьерная фотография.",
            },
        ],
    },
];
---

<section id="portfolio" class="portfolio">
     <div class="section-container-wide">
        <div class="section-container">
            <span class="section-tag">МОИ ИНТЕРЬЕРЫ</span>

        <h2 class="section-title">
            Посмотрите, как меняется пространство
        </h2>
        </div>
         
        

        <BaseSwiper sliderName="portfolio">
            {
                slides.map((slide) => (
                    <div
                        class={`swiper-slide portfolio-slide portfolio-slide--${slide.type}`}
                    >
                        <div class="section-container portfolio-slide-inner">
                            {
                                slide.title && (
                                    <h3 class="section-subtitle slide-title">
                                        {slide.title}
                                    </h3>
                                )
                            }
        
                            <div class="slide-content">
                                {
                                    slide.items.map((item, index) => (
                                        <figure
                                            class:list={[
                                                "portfolio-item",
        
                                                slide.type === "transformation" &&
                                                    index === 0 &&
                                                    "portfolio-item--before",
        
                                                slide.type === "transformation" &&
                                                    index === 1 &&
                                                    "portfolio-item--after",
        
                                                slide.type === "gallery" &&
                                                    item.orientation &&
                                                    `portfolio-item--${item.orientation}`,
                                            ]}
                                        >
                                            <div class="portfolio-image">
                                                <img
                                                    class="image"
                                                    src={item.image.src}
                                                    alt={item.alt}
                                                />
        
                                                {
                                                    item.label && (
                                                        <span class="image-label">
                                                            {item.label}
                                                        </span>
                                                    )
                                                }
                                            </div>
        
                                            <figcaption class="item-caption">
                                                <p class="info-text">
                                                    {item.text}
                                                </p>
                                            </figcaption>
                                        </figure>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                ))
            }
        </BaseSwiper>
    </div> 
</section>

<style>
    :global(.portfolio-swiper) {
        position: relative;
    }

    .portfolio-slide {
    opacity: 1;
    transform: scale(1);

    transition:
    opacity var(--transition-long),
    transform var(--transition-long);
    }

    .portfolio-slide-inner {
        display: flex;
        flex-direction: column;
        gap: var(--px-32);
    }
    .swiper-slide-prev,
    .swiper-slide-next {
        opacity: 0;
        transform: scale(0.75);
    }

    .slide-title {
        margin-bottom: 0;
    }

    .slide-content {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--px-32);
        align-items: start;
    }

    .portfolio-item {
        display: flex;
        flex-direction: column;
        gap: var(--px-8);
        margin: 0;
        min-width: 0;
    }

    .portfolio-image {
        position: relative;
        overflow: hidden;
    }

    /*
        Transformation

    */

    .portfolio-slide--transformation .portfolio-image {
        min-height: 25rem;
    }

    .portfolio-slide--transformation .portfolio-image .image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .image-label {
        position: absolute;
        left: var(--px-16);
        bottom: var(--px-16);
        z-index: 1;
        padding: var(--px-8) var(--px-16);
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(0.25rem);
        font-size: var(--text-sm);
        font-weight: 500;
        line-height: 1;
    }

    /*
        Gallery

    */

    .portfolio-slide--gallery .slide-content {
        align-items: start;
    }

    .portfolio-slide--gallery .portfolio-image {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        width: 100%;
        min-height: 0;
    }

    .portfolio-slide--gallery .portfolio-image .image {
        position: static;
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
    }

   
    .portfolio-item--landscape .portfolio-image {
        width: 100%;
    }

  
    .portfolio-item--portrait {
        align-items: center;
    }

    .portfolio-item--portrait .portfolio-image {
        width: 55%;
        margin-inline: auto;
    }

    .portfolio-item--portrait .item-caption {
        width: 55%;
        margin-inline: auto;
    }

    .item-caption {
        display: flex;
        flex-direction: column;
        gap: var(--px-8);
    }

    .info-text {
        margin: 0;
        background: white;
        padding: var(--px-8);
    }

    @media screen and (max-width: 64rem) {
        .slide-content {
            gap: var(--px-24);
        }

        .portfolio-slide {
            gap: var(--px-24);
        }

        .portfolio-item--portrait .portfolio-image,
        .portfolio-item--portrait .item-caption {
            width: 78%;
        }
        .info-text {
            font-size: var(--text-xs);
            line-height: 1;
            font-style: italic;
        }
    }

    @media screen and (max-width: 55rem) {
       

        .portfolio-slide {
            gap: var(--px-24);
        }

        /*
            GALLERY — mobile

         
        */

        .portfolio-slide--gallery .slide-content {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .portfolio-slide--gallery .portfolio-item {
            width: 100%;
        }

        .portfolio-slide--gallery
            .portfolio-item--landscape
            .portfolio-image {
            width: 60%;
        }

        .portfolio-slide--gallery
            .portfolio-item--landscape
            .item-caption {
            width: 100%;
        }

     
        .portfolio-slide--gallery
            .portfolio-item--portrait
            .portfolio-image {
            width: 35%;
            margin-inline: auto;
        }

        .portfolio-slide--gallery
            .portfolio-item--portrait
            .item-caption {
            width: 35%;
            margin-inline: auto;
        }

        /*
            TRANSFORMATION — mobile

        */

        .portfolio-slide--transformation .slide-content {
            display: block;
            position: relative;
            min-height: 32rem;
        }
/* 
        .portfolio-slide--transformation .portfolio-item {
            gap: var(--px-12);
        } */

        .portfolio-slide--transformation .portfolio-item--before {
            position: absolute;
            top: 0;
            left: 0;
            width: 43%;
            z-index: 2;
        }

        .portfolio-slide--transformation
            .portfolio-item--before
            .portfolio-image {
            min-height: 11rem;
        }

        .portfolio-slide--transformation
            .portfolio-item--before
            .item-caption {
            padding-right: var(--px-8);
        }

        .portfolio-slide--transformation .portfolio-item--after {
            width: 72%;
            margin-left: auto;
            padding-top: var(--px-64);
        }

        .portfolio-slide--transformation
            .portfolio-item--after
            .portfolio-image {
            min-height: 22rem;
        }

        .image-label {
            left: var(--px-12);
            bottom: var(--px-12);
            padding: var(--px-8) var(--px-12);
        }
    }

    @media screen and (max-width: 36rem) {
        .portfolio-slide--transformation .slide-content {
            min-height: 29rem;
        }

        .portfolio-slide--transformation .portfolio-item--before {
            width: 45%;
        }

        .portfolio-slide--transformation
            .portfolio-item--before
            .portfolio-image {
            min-height: 9rem;
        }

        .portfolio-slide--transformation .portfolio-item--after {
            width: 74%;
            padding-top: var(--px-48);
        }

        .portfolio-slide--transformation
            .portfolio-item--after
            .portfolio-image {
            min-height: 19rem;
        }

        .portfolio-slide--gallery
            .portfolio-item--portrait
            .portfolio-image,
        .portfolio-slide--gallery
            .portfolio-item--portrait
            .item-caption {
            width: 40%;
        }
    }
</style>

<script>
    import { initSwiper } from "@utils/initSwiper";

    let portfolioSwiper;

    function initPortfolioSlider() {
        console.log("[portfolio] init called");

        const slider = document.querySelector(".portfolio-swiper");
        console.log("[portfolio] slider element:", slider);

        if (!slider) {
            console.warn("[portfolio] slider not found");
            return;
        }

        console.log(
            "[portfolio] slides before init:",
            slider.querySelectorAll(".swiper-slide").length
        );

        console.log(
            "[portfolio] classes before init:",
            slider.className
        );

        if (portfolioSwiper && !portfolioSwiper.destroyed) {
            console.log("[portfolio] destroying previous swiper");
            portfolioSwiper.destroy(true, true);
        }

        try {
            portfolioSwiper = initSwiper("portfolio", {
                spaceBetween: 30,

                navigation: {
                    nextEl: ".portfolio-next",
                    prevEl: ".portfolio-prev",
                },

                pagination: {
                    el: ".portfolio-pagination",
                    clickable: true,
                },

                on: {
                    init(swiper) {
                        console.log("[portfolio] swiper init event", swiper);
                    },

                    afterInit(swiper) {
                        console.log("[portfolio] afterInit", {
                            initialized: swiper.initialized,
                            activeIndex: swiper.activeIndex,
                            realIndex: swiper.realIndex,
                            width: swiper.width,
                            height: swiper.height,
                            slides: swiper.slides.length,
                        });
                    },

                    slideChange(swiper) {
                        console.log("[portfolio] slideChange", {
                            activeIndex: swiper.activeIndex,
                            realIndex: swiper.realIndex,
                        });
                    },
                },
            });

            console.log("[portfolio] swiper instance:", portfolioSwiper);

            console.log("[portfolio] state immediately after init:", {
                initialized: portfolioSwiper?.initialized,
                destroyed: portfolioSwiper?.destroyed,
                activeIndex: portfolioSwiper?.activeIndex,
                realIndex: portfolioSwiper?.realIndex,
                width: portfolioSwiper?.width,
                height: portfolioSwiper?.height,
                slides: portfolioSwiper?.slides?.length,
            });

            console.log(
                "[portfolio] classes after init:",
                slider.className
            );

            console.log(
                "[portfolio] wrapper transform:",
                getComputedStyle(
                    slider.querySelector(".swiper-wrapper")
                ).transform
            );
        } catch (error) {
            console.error("[portfolio] INIT ERROR:", error);
        }
    }

    document.addEventListener("astro:page-load", () => {
        console.log("[portfolio] astro:page-load");
        initPortfolioSlider();
    });
</script>