---
import BaseSwiper from "./BaseSwiper.astro";
import { Image } from "astro:assets";
import before1Image from "/src/assets/images/студия 353 _2.png";
import after1Image from "/src/assets/images/студия 353 _1.png";
import before2Image from "/src/assets/images/студия 354_2.png";
import after2Image from "/src/assets/images/студия 354_1.png";
import vanityImage from "/src/assets/images/туалетный столик.png";
import storageImage from "/src/assets/images/студия 354_1.png";
import corkBoardImage from "/src/assets/images/студия 354_1.png";
import bathroomImage from "/src/assets/images/студия 354_1.png";

const projects = [
    {
        id: 1,
        images: {
            before: {
                src: before1Image,
                alt: "Студия до обустройства: готовый ремонт, пустое пространство без мебели, текстиля и декора.",
            },
            after: {
                src: after1Image,
                alt: "Готовая студия после обустройства: мебель, освещение, текстиль, техника и декор.",
            },
        },
        info: {
            challenge: {
                title: "Задача",
                text: "Полностью обустроить небольшую студию после ремонта и подготовить её к аренде. Важно было сохранить разумный бюджет, не перегрузить пространство и сделать квартиру удобной для повседневной жизни.",
            },
            result: {
                title: "Что изменилось",
                text: "Подобраны мебель, освещение, текстиль, техника, декор и бытовое наполнение. В результате пустое помещение превратилось в цельную, функциональную квартиру, полностью готовую к заселению.",
            },
        },
    },
    {
        id: 2,
        images: {
            before: {
                src: before2Image,
                alt: "Квартира до обновления интерьера: базовая мебель и готовый ремонт без единого визуального оформления.",
            },
            after: {
                src: after2Image,
                alt: "Квартира после обновления: оформленный интерьер с текстилем, светом, декором и дополнительной мебелью.",
            },
        },
        info: {
            challenge: {
                title: "Задача",
                text: "Сделать уже готовый интерьер более цельным и выразительным без нового ремонта и полной замены мебели. Нужно было добавить недостающие детали и сохранить функциональность пространства.",
            },
            result: {
                title: "Что изменилось",
                text: "Интерьер дополнен текстилем, светом, декором и отдельными предметами мебели. За счёт небольших изменений пространство стало уютнее, визуально собраннее и привлекательнее на фотографиях.",
            },
        },
    },
];

const details = [
    {
        id: 1,
        image: {
            src: vanityImage,
            alt: "Туалетный столик с ярким креслом в оформленном интерьере.",
        },
        info: {
            title: "Не боюсь цвета",
            text: "Яркий акцент может собрать весь интерьер. А мебель нужного размера можно сделать на заказ — так пространство используется по максимуму, а всё необходимое помещается внутри.",
        },
    },

    {
        id: 2,
        image: {
            src: bathroomImage,
            alt: "Продуманная система хранения в ванной комнате.",
        },
        info: {
            title: "Хранение под привычки хозяев",
            text: "Продумываю не просто место для хранения, а то, чем действительно будут пользоваться: высокие флаконы, небольшие баночки, полотенца и бытовые мелочи.",
        },
    },

    {
        id: 3,
        image: {
            src: corkBoardImage,
            alt: "Пробковая доска как функциональный элемент оформления стены.",
        },
        info: {
            title: "Стены тоже могут быть живыми",
            text: "Необязательно заполнять их только картинами и постерами. Иногда функциональная вещь может стать частью интерьера — и меняться вместе с вами.",
        },
    },

    {
        id: 4,
        image: {
            src: storageImage,
            alt: "Сочетание графитового шкафа и белого стеллажа в интерьере.",
        },
        info: {
            title: "Сочетаю, а не комплектую",
            text: "Мебель из разных коллекций может выглядеть цельно. Главное — найти связь в цвете, пропорциях и деталях и не потерять функциональность.",
        },
    },
];
---

<section id="portfolio" class="portfolio">
    <div class="section-container">
        <span class="section-tag">МОИ ИНТЕРЬЕРЫ</span>
        <h2 class="section-title">Посмотрите, как меняется пространство</h2>

        <BaseSwiper sliderName="portfolio" beforeAfter>
            {
                projects.map((project) => (
                    <div class="swiper-slide">
                        <div class="project-image">
                            <Image
                                class="image before"
                                src={project.images.before.src}
                                alt={project.images.before.alt}
                                width={800}
                                aria-hidden="true"
                            />
                            <Image
                                class="image after active"
                                src={project.images.after.src}
                                alt={project.images.after.alt}
                                width={1144}
                                height={800}
                                aria-hidden="false"
                            />
                        </div>

                        <div class="project-info">
                            <div class="info-section">
                                <h3 class="section-subtitle info-title">
                                    {project.info.challenge.title}
                                </h3>
                                <p class="info-text">
                                    {project.info.challenge.text}
                                </p>
                            </div>

                            <div class="info-section">
                                <h3 class="section-subtitle info-title">
                                    {project.info.result.title}
                                </h3>
                                <p class="info-text">
                                    {project.info.result.text}
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </BaseSwiper>
        <p class="middle-text">Цвет, хранение, мебель нужного размера и оформление стен — иногда именно детали делают пространство удобным и цельным.</p>
        <BaseSwiper sliderName="details">
            {
                details.map((detail) => (
                    <div class="swiper-slide">
                         <div class="detail-info">
                            <h3 class="section-subtitle detail-title">
                                {detail.info.title}
                            </h3>
        
                            <p class="detail-text">
                                {detail.info.text}
                            </p>
                        </div>
                        <div class="detail-image">
                            <Image
                                class="image"
                                src={detail.image.src}
                                alt={detail.image.alt}
                                width={1144}
                                height={1200}
                            />
                        </div>
        
                       
                    </div>
                ))
            }
        </BaseSwiper>
    </div>
</section>

<style>
    :global(.portfolio-swiper),
    :global(.details-swiper) {
        padding-inline: var(--px-64);
        position: relative;
    }

    .swiper-slide {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        opacity: 0;
        transform: scale(0.75);
        transition: all var(--transition-long);
    }

    .swiper-slide-active {
        opacity: 1;
        transform: scale(1);
    }

    .swiper-slide-prev,
    .swiper-slide-next {
        opacity: 0;
        transform: scale(0.75);
    }

    .project-image {
    position: relative;
    min-height: 25rem;
    overflow: hidden;
}

.detail-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
}

    .project-image .image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity var(--transition-long);
    }

    .project-image .image.active {
        opacity: 1;
    }

    .detail-image .image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-info,
    .detail-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--px-32);
    }

    .info-section {
        display: flex;
        flex-direction: column;
        gap: var(--px-16);
    }

    .info-title {
        margin-bottom: 0;
    }

    .view-details {
        display: inline-flex;
        font-weight: 500;
        margin-top: auto;
    }

    .btn--secondary {
        border-bottom: var(--px-2) solid currentColor;
    }

    .btn--secondary-hovered {
        display: block;
    }

    @media screen and (max-width: 64rem) {
        .swiper-slide {
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 55rem) {
        :global(.portfolio-swiper),
        :global(.details-swiper) {
            padding-inline: 0;
        }

        .swiper-slide {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }
    }
    .middle-text {
        margin-block: var(--px-64) var(--px-64);
    }
</style>

<script>
    import { initSwiper } from "@utils/initSwiper";

    function initPortfolioSlider() {
        const portfolioSwiper = initSwiper("portfolio", {
            spaceBetween: 30,
            navigation: {
                nextEl: ".portfolio-next",
                prevEl: ".portfolio-prev",
            },
            pagination: {
                el: ".portfolio-pagination",
                clickable: true,
            },
        });

        const detailsSwiper = initSwiper("details", {
            spaceBetween: 30,
            navigation: {
                nextEl: ".details-next",
                prevEl: ".details-prev",
            },
            pagination: {
                el: ".details-pagination",
                clickable: true,
            },
        });

        const updateSlideView = (view: string, slide: HTMLElement) => {
            const images = slide.querySelectorAll(".image");

            images.forEach((img) => {
                if (img.classList.contains(view)) {
                    img.classList.add("active");
                    img.setAttribute("aria-hidden", "false");
                } else {
                    img.classList.remove("active");
                    img.setAttribute("aria-hidden", "true");
                }
            });
        };

        document.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
                ".toggle-btn",
            );
            if (!btn) return;

            document
                .querySelector(".toggle-btn.active")
                ?.classList.remove("active");
            btn.classList.add("active");

            const view = btn.dataset.view;
            const currentSlide =
                portfolioSwiper.slides[portfolioSwiper.activeIndex];

            if (currentSlide && view) {
                updateSlideView(view, currentSlide);
            }
        });

        portfolioSwiper.on("slideChangeTransitionStart", () => {
            const activeSlide =
                portfolioSwiper.slides[portfolioSwiper.activeIndex];

            if (activeSlide) {
                updateSlideView("after", activeSlide);
            }

            document
                .querySelector(".toggle-btn.active")
                ?.classList.remove("active");

            document
                .querySelector('.toggle-btn[data-view="after"]')
                ?.classList.add("active");
        });

        return () => {
            portfolioSwiper.destroy();
            detailsSwiper.destroy();
        };
    }

    let cleanup = initPortfolioSlider();

    document.addEventListener("astro:after-swap", () => {
        if (cleanup) cleanup();
        cleanup = initPortfolioSlider();
    });
</script>